<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Confirmed</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #d4edda; padding: 20px; border-radius: 4px; margin-bottom: 20px; border: 1px solid #c3e6cb; }
        .header h1 { color: #155724; margin: 0 0 10px 0; }
        .order-id { font-size: 20px; font-weight: bold; color: #155724; }
        .section { margin-bottom: 20px; }
        .section-title { font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #1a73e8; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #e0e0e0; }
        th { background: #f5f5f5; font-weight: bold; }
        .highlight { background: #f0f7ff; padding: 15px; border-radius: 4px; border-left: 4px solid #1a73e8; }
        .footer { color: #999; font-size: 12px; margin-top: 40px; border-top: 1px solid #e0e0e0; padding-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✓ Payment Confirmed</h1>
            <p class="order-id">Order #{{orderId}}</p>
        </div>

        <div class="section">
            <p>Thank you! Your payment has been successfully received and processed.</p>
        </div>

        <div class="highlight">
            <table>
                <tr>
                    <td><strong>Amount Paid:</strong></td>
                    <td style="text-align: right; font-size: 18px; color: #155724;">{{formatMoney amount}}</td>
                </tr>
                <tr>
                    <td><strong>Payment Method:</strong></td>
                    <td style="text-align: right;">{{paymentMethod}}</td>
                </tr>
                <tr>
                    <td><strong>Transaction ID:</strong></td>
                    <td style="text-align: right; font-family: monospace;">{{transactionId}}</td>
                </tr>
                <tr>
                    <td><strong>Paid At:</strong></td>
                    <td style="text-align: right;">{{formatDate paidAt}}</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <h2 class="section-title">What Happens Next?</h2>
            <ol>
                <li><strong>Processing:</strong> We're preparing your order for shipment</li>
                <li><strong>Fulfillment:</strong> Your items will be carefully packed</li>
                <li><strong>Shipping:</strong> You'll receive tracking information within 24 hours</li>
            </ol>
        </div>

        <div class="section">
            <h2 class="section-title">Order Details</h2>
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each items}}
                    <tr>
                        <td>{{this.productName}}</td>
                        <td>{{this.quantity}}</td>
                        <td>{{formatMoney this.subtotal}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <div class="footer">
            <p>Keep this email for your records. Questions? Contact our support team.</p>
            <p>&copy; {{currentYear}} {{companyName}}. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
