generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  priceInCents Int      /// Price in cents (e.g., 1999 = $19.99)
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?  /// Soft delete timestamp
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  CartItem    CartItem[]
}

model Cart {
  id            Int      @id @default(autoincrement())
  sessionId     String   @unique
  items         CartItem[]
  lastActivityAt DateTime @default(now()) @updatedAt /// Track inactivity for TTL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      /// Renamed from 'qty' for API consistency
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

/// Audit log for admin actions — immutable trail
model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String   /// CREATE_PRODUCT, UPDATE_PRODUCT, DEACTIVATE_PRODUCT
  entityType String  /// PRODUCT
  entityId  Int
  beforeState Json?    /// Snapshot before change
  afterState Json      /// Snapshot after change
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AdminAuditLog[]
  orders    Order[]
}

/// Order — immutable snapshot of a checkout
model Order {
  id              String   @id @default(cuid())
  userId          Int      /// Required: All orders must have user ID
  currency        String   /// ISO 4217 code (USD, EUR, etc.)
  
  /// Items snapshot (locked prices at purchase time)
  items           OrderItem[]
  
  /// Pricing breakdown (all immutable)
  subtotalAmountCents     Int  /// Sum of all item subtotals
  discountTotalAmountCents Int @default(0) /// Sum of all discounts
  taxAmountCents          Int @default(0) /// For Phase 5+
  shippingCostCents       Int @default(0) /// For Phase 5+
  
  /// Final totals (authoritative)
  totalBeforePaymentCents Int /// subtotal - discounts + tax + shipping
  finalTotalAmountCents   Int /// After any additional processing
  
  /// Applied discounts (JSON array for audit)
  appliedDiscounts        Json[] @default([]) /// Array of AppliedDiscount objects
  
  /// Order status
  status                  String @default("PENDING") /// PENDING, CHECKOUT, PAYMENT_FAILED, PAID, FULFILLED, CANCELLED
  
  /// Fulfillment tracking (PHASE 7)
  fulfillmentStatus       String @default("pending") /// pending, processing, shipped, delivered, cancelled
  shippingProvider        String? /// FedEx, UPS, USPS, DHL, etc.
  trackingNumber          String? /// Tracking number from shipping provider
  shippedAt               DateTime? /// When order was shipped
  deliveredAt             DateTime? /// When order was delivered
  
  /// Metadata
  createdAt               DateTime @default(now())
  paidAt                  DateTime?
  expiresAt               DateTime? /// For abandoned order cleanup (30 days)
  
  /// Relations
  user                    User? @relation(fields: [userId], references: [id])
  payment                 Payment?
  
  @@index([userId])
  @@index([status])
  @@index([fulfillmentStatus])
  @@index([createdAt])
}

/// Order item — immutable snapshot of product at purchase
model OrderItem {
  id                    String @id @default(cuid())
  orderId               String
  productId             Int
  productName           String /// Snapshot of product name
  unitPriceCents        Int    /// Price per unit at purchase time
  quantity              Int
  subtotalAmountCents   Int    /// unitPrice * quantity
  
  order                 Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
}

/// Payment — tracks payment provider interactions
model Payment {
  id                String @id @default(cuid())
  orderId           String @unique /// One payment per order
  provider          String /// stripe, midtrans, paypal, etc.
  providerPaymentId String /// External payment ID from provider
  status            String @default("PENDING") /// PENDING, PROCESSING, PAID, FAILED, REFUNDED, CANCELLED
  
  /// Raw webhook payload (for debugging)
  rawWebhookPayload Json?
  
  /// Idempotency
  idempotencyKey    String? @unique /// For webhook deduplication
  webhookReceivedAt DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  order             Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
  @@index([provider])
  @@index([status])
}

/// Discount rule — stored for reusability and audit
model DiscountRule {
  id              String @id @default(cuid())
  code            String? @unique /// e.g., "SAVE10"
  type            String /// percentage, fixed_amount
  value           Int /// 10 for 10%, 500 for $5 off
  appliesTo       String /// cart_wide, specific_product, category
  
  /// Scope
  targetProductIds Int[] @default([]) /// For specific_product scope
  minCartValueCents Int? /// Only apply if cart >= this value
  
  /// Usage tracking
  maxUsageCount   Int?
  usageCount      Int @default(0)
  
  /// Stacking rules
  isStackable     Boolean @default(true)
  priority        Int @default(0) /// Higher = applied first
  isActive        Boolean @default(true)
  expiresAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isActive])
  @@index([expiresAt])
}

/// Refund — tracks all refund operations for audit & idempotency
model Refund {
  id                  String   @id @default(cuid())
  orderId             String
  paymentId           String
  amountCents         Int      /// Amount refunded in cents
  reason              String   /// Why refund happened
  status              String   @default("REFUNDED") /// REFUNDED, FAILED, PENDING
  externalRefundId    String?  /// External refund ID from provider (e.g., Stripe refund ID)
  
  /// Partial refund tracking (PHASE 6)
  isPartial           Boolean  @default(false)
  itemRefunds         ItemRefund[]
  
  /// Metadata for debugging
  metadata            Json?    /// Provider-specific data
  
  createdAt           DateTime @default(now())
  
  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

/// Item-level refund tracking for partial refunds
model ItemRefund {
  id              String @id @default(cuid())
  refundId        String
  orderItemId     String
  amountCents     Int    /// Amount refunded for this specific item
  quantity        Int    /// Quantity refunded (may be less than full qty)
  
  refund          Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@unique([refundId, orderItemId])
  @@index([refundId])
}

/// Webhook Log — stores all incoming payment webhooks for replay & audit (PHASE 6)
model WebhookLog {
  id                  String   @id @default(cuid())
  
  /// Webhook identification
  provider            String   /// stripe, midtrans, paypal, etc.
  eventType           String   /// payment.completed, payment.failed, etc.
  externalEventId     String?  /// External event ID from provider
  
  /// Raw data
  rawPayload          Json     /// Complete webhook payload
  headers             Json     /// Webhook headers (for signature verification)
  
  /// Processing status
  status              String   @default("PENDING") /// PENDING, PROCESSING, SUCCESS, FAILED
  processedAt         DateTime?
  errorMessage        String?
  
  /// Idempotency
  idempotencyKey      String   @unique /// For deduplication
  
  /// Audit & debugging
  ipAddress           String?  /// Source IP of webhook
  attempts            Int      @default(0) /// Number of processing attempts
  nextRetryAt         DateTime? /// Next scheduled retry
  
  /// Related resources
  orderId             String?  /// Linked order if identifiable
  paymentId           String?  /// Linked payment if identifiable
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([provider, externalEventId])
  @@index([provider])
  @@index([status])
  @@index([orderId])
  @@index([paymentId])
  @@index([createdAt])
  @@index([nextRetryAt])
}

/// Analytics Snapshot — pre-aggregated metrics for fast dashboard loading (PHASE 7)
model AnalyticsSnapshot {
  id                    String   @id @default(cuid())
  
  /// Time period
  date                  DateTime /// Date of the snapshot (start of day/hour)
  granularity           String   /// daily, hourly
  
  /// Revenue metrics
  revenueCents          Int      @default(0) /// Total revenue for period
  orderCount            Int      @default(0) /// Number of orders
  paidOrderCount        Int      @default(0) /// Successfully paid orders
  failedOrderCount      Int      @default(0) /// Failed payment orders
  cancelledOrderCount   Int      @default(0) /// Cancelled orders
  
  /// Refund metrics
  refundCount           Int      @default(0) /// Number of refunds
  refundAmountCents     Int      @default(0) /// Total refund amount
  partialRefundCount    Int      @default(0) /// Partial refunds
  fullRefundCount       Int      @default(0) /// Full refunds
  
  /// Average order value
  avgOrderValueCents    Int      @default(0) /// Average order value
  
  /// Payment provider breakdown (JSON)
  providerBreakdown     Json?    /// {stripe: 1000, midtrans: 500, etc.}
  
  /// Fulfillment metrics
  shippedOrderCount     Int      @default(0) /// Orders shipped
  deliveredOrderCount   Int      @default(0) /// Orders delivered
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([date, granularity])
  @@index([date])
  @@index([granularity])
  @@index([createdAt])
}
