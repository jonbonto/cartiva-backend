generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  priceInCents Int      /// Price in cents (e.g., 1999 = $19.99)
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?  /// Soft delete timestamp
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  CartItem    CartItem[]
}

model Cart {
  id            Int      @id @default(autoincrement())
  sessionId     String   @unique
  items         CartItem[]
  lastActivityAt DateTime @default(now()) @updatedAt /// Track inactivity for TTL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      /// Renamed from 'qty' for API consistency
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

/// Audit log for admin actions — immutable trail
model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String   /// CREATE_PRODUCT, UPDATE_PRODUCT, DEACTIVATE_PRODUCT
  entityType String  /// PRODUCT
  entityId  Int
  beforeState Json?    /// Snapshot before change
  afterState Json      /// Snapshot after change
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   /// NEW: Address & Payment Management
  shippingAddresses  UserShippingAddress[]  @relation("UserShippingAddresses")
  paymentMethods     UserPaymentMethod[]    @relation("UserPaymentMethods")

  auditLogs AdminAuditLog[]
  orders    Order[]
  
  /// Affiliate profile (if user is an affiliate)
  affiliate Affiliate?
  
  /// Affiliate application (if user has applied)
  affiliateApplication AffiliateApplication? @relation("AffiliateApplications")
}

/// Order — immutable snapshot of a checkout
model Order {
  id              String   @id @default(cuid())
  userId          Int      /// Required: All orders must have user ID
  currency        String   /// ISO 4217 code (USD, EUR, etc.)
  
  /// Items snapshot (locked prices at purchase time)
  items           OrderItem[]
  
  /// Pricing breakdown (all immutable)
  subtotalAmountCents     Int  /// Sum of all item subtotals
  discountTotalAmountCents Int @default(0) /// Sum of all discounts
  taxAmountCents          Int @default(0) /// For Phase 5+
  shippingCostCents       Int @default(0) /// For Phase 5+
  
  /// Final totals (authoritative)
  totalBeforePaymentCents Int /// subtotal - discounts + tax + shipping
  finalTotalAmountCents   Int /// After any additional processing
  
  /// Applied discounts (JSON array for audit)
  appliedDiscounts        Json[] @default([]) /// Array of AppliedDiscount objects
  
  /// Order status
  status                  String @default("PENDING") /// PENDING, CHECKOUT, PAYMENT_FAILED, PAID, FULFILLED, CANCELLED
  
  /// Fulfillment tracking (PHASE 7)
  fulfillmentStatus       String @default("pending") /// pending, processing, shipped, delivered, cancelled
  shippingProvider        String? /// FedEx, UPS, USPS, DHL, etc.
  trackingNumber          String? /// Tracking number from shipping provider
  shippedAt               DateTime? /// When order was shipped
  deliveredAt             DateTime? /// When order was delivered
  
  /// Shipping (PHASE 6)
  shippingMethodId        String?
  shippingMethod          ShippingMethod? @relation("ShippingMethod", fields: [shippingMethodId], references: [id])
  shippingAddress         ShippingAddress? /// One-to-one with order
  
  /// Metadata
  createdAt               DateTime @default(now())
  paidAt                  DateTime?
  expiresAt               DateTime? /// For abandoned order cleanup (30 days)
  
  /// Relations
  user                    User? @relation(fields: [userId], references: [id])
  payment                 Payment?
  
  @@index([userId])
  @@index([status])
  @@index([fulfillmentStatus])
  @@index([shippingMethodId])
  @@index([createdAt])
}

/// Order item — immutable snapshot of product at purchase
model OrderItem {
  id                    String @id @default(cuid())
  orderId               String
  productId             Int
  productName           String /// Snapshot of product name
  unitPriceCents        Int    /// Price per unit at purchase time
  quantity              Int
  subtotalAmountCents   Int    /// unitPrice * quantity
  
  /// Inventory reservation (PHASE 6)
  reservationId         String?
  reservation           InventoryReservation? @relation(fields: [reservationId], references: [id])
  
  order                 Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
  @@index([reservationId])
}

/// Payment — tracks payment provider interactions
model Payment {
  id                String @id @default(cuid())
  orderId           String @unique /// One payment per order
  provider          String /// stripe, midtrans, paypal, etc.
  providerPaymentId String /// External payment ID from provider
  status            String @default("PENDING") /// PENDING, PROCESSING, PAID, FAILED, REFUNDED, CANCELLED
  
  /// Raw webhook payload (for debugging)
  rawWebhookPayload Json?
  
  /// Idempotency
  idempotencyKey    String? @unique /// For webhook deduplication
  webhookReceivedAt DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  order             Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
  @@index([provider])
  @@index([status])
}

/// Discount rule — stored for reusability and audit
model DiscountRule {
  id              String @id @default(cuid())
  code            String? @unique /// e.g., "SAVE10"
  type            String /// percentage, fixed_amount
  value           Int /// 10 for 10%, 500 for $5 off
  appliesTo       String /// cart_wide, specific_product, category
  
  /// Scope
  targetProductIds Int[] @default([]) /// For specific_product scope
  minCartValueCents Int? /// Only apply if cart >= this value
  
  /// Usage tracking
  maxUsageCount   Int?
  usageCount      Int @default(0)
  
  /// Stacking rules
  isStackable     Boolean @default(true)
  priority        Int @default(0) /// Higher = applied first
  isActive        Boolean @default(true)
  expiresAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isActive])
  @@index([expiresAt])
}

/// Refund — tracks all refund operations for audit & idempotency
model Refund {
  id                  String   @id @default(cuid())
  orderId             String
  paymentId           String
  amountCents         Int      /// Amount refunded in cents
  reason              String   /// Why refund happened
  status              String   @default("REFUNDED") /// REFUNDED, FAILED, PENDING
  externalRefundId    String?  /// External refund ID from provider (e.g., Stripe refund ID)
  
  /// Partial refund tracking (PHASE 6)
  isPartial           Boolean  @default(false)
  itemRefunds         ItemRefund[]
  
  /// Metadata for debugging
  metadata            Json?    /// Provider-specific data
  
  createdAt           DateTime @default(now())
  
  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

/// Item-level refund tracking for partial refunds
model ItemRefund {
  id              String @id @default(cuid())
  refundId        String
  orderItemId     String
  amountCents     Int    /// Amount refunded for this specific item
  quantity        Int    /// Quantity refunded (may be less than full qty)
  
  refund          Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@unique([refundId, orderItemId])
  @@index([refundId])
}

/// Webhook Log — stores all incoming payment webhooks for replay & audit (PHASE 6)
model WebhookLog {
  id                  String   @id @default(cuid())
  
  /// Webhook identification
  provider            String   /// stripe, midtrans, paypal, etc.
  eventType           String   /// payment.completed, payment.failed, etc.
  externalEventId     String?  /// External event ID from provider
  
  /// Raw data
  rawPayload          Json     /// Complete webhook payload
  headers             Json     /// Webhook headers (for signature verification)
  
  /// Processing status
  status              String   @default("PENDING") /// PENDING, PROCESSING, SUCCESS, FAILED
  processedAt         DateTime?
  errorMessage        String?
  
  /// Idempotency
  idempotencyKey      String   @unique /// For deduplication
  
  /// Audit & debugging
  ipAddress           String?  /// Source IP of webhook
  attempts            Int      @default(0) /// Number of processing attempts
  nextRetryAt         DateTime? /// Next scheduled retry
  
  /// Related resources
  orderId             String?  /// Linked order if identifiable
  paymentId           String?  /// Linked payment if identifiable
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([provider, externalEventId])
  @@index([provider])
  @@index([status])
  @@index([orderId])
  @@index([paymentId])
  @@index([createdAt])
  @@index([nextRetryAt])
}

/// Analytics Snapshot — pre-aggregated metrics for fast dashboard loading (PHASE 7)
model AnalyticsSnapshot {
  id                    String   @id @default(cuid())
  
  /// Time period
  date                  DateTime /// Date of the snapshot (start of day/hour)
  granularity           String   /// daily, hourly
  
  /// Revenue metrics
  revenueCents          Int      @default(0) /// Total revenue for period
  orderCount            Int      @default(0) /// Number of orders
  paidOrderCount        Int      @default(0) /// Successfully paid orders
  failedOrderCount      Int      @default(0) /// Failed payment orders
  cancelledOrderCount   Int      @default(0) /// Cancelled orders
  
  /// Refund metrics
  refundCount           Int      @default(0) /// Number of refunds
  refundAmountCents     Int      @default(0) /// Total refund amount
  partialRefundCount    Int      @default(0) /// Partial refunds
  fullRefundCount       Int      @default(0) /// Full refunds
  
  /// Average order value
  avgOrderValueCents    Int      @default(0) /// Average order value
  
  /// Payment provider breakdown (JSON)
  providerBreakdown     Json?    /// {stripe: 1000, midtrans: 500, etc.}
  
  /// Fulfillment metrics
  shippedOrderCount     Int      @default(0) /// Orders shipped
  deliveredOrderCount   Int      @default(0) /// Orders delivered
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([date, granularity])
  @@index([date])
  @@index([granularity])
  @@index([createdAt])
}
/// Tax Rule — defines tax rates by region (PHASE 6)
model TaxRule {
  id              String @id @default(cuid())
  
  /// Region targeting
  country         String? /// ISO 3166-1 alpha-2 (US, CA, AU, etc.) or null for global
  state           String? /// State/province code (CA, NY, etc.) or null for country-wide
  city            String? /// City name or null for state-wide
  
  /// Tax rate
  taxRatePercent  Float  /// Tax rate as percentage (e.g., 8.5 for 8.5%)
  taxRateDecimal  Decimal @db.Decimal(5, 4) /// Precise decimal format (0.0850 for 8.5%)
  
  /// Status
  isActive        Boolean @default(true)
  expiresAt       DateTime?
  
  /// Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([country])
  @@index([state])
  @@index([city])
  @@index([isActive])
  @@unique([country, state, city]) /// Most specific rule wins
}

/// Shipping Method — defines available shipping options (PHASE 6)
model ShippingMethod {
  id              String @id @default(cuid())
  
  /// Method definition
  name            String /// Standard, Express, Overnight, etc.
  description     String?
  
  /// Pricing
  baseCostCents   Int    /// Base shipping cost in cents
  perKgCostCents  Int @default(0) /// Additional cost per kg
  perKmCostCents  Int @default(0) /// Additional cost per km (for distance-based)
  
  /// Constraints
  minWeightGrams  Int @default(0)
  maxWeightGrams  Int?
  minDeliveryDays Int
  maxDeliveryDays Int
  
  /// Coverage
  allowedCountries String[] @default([]) /// ISO country codes; empty = all countries
  
  /// Status
  isActive        Boolean @default(true)
  expiresAt       DateTime?
  
  /// Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  /// Relations
  orders          Order[] @relation("ShippingMethod")
  
  @@index([isActive])
  @@index([name])
}

/// Inventory Reservation — holds stock for pending payments (PHASE 6)
model InventoryReservation {
  id              String @id @default(cuid())
  
  /// Product & quantity
  productId       Int    /// Product being reserved
  quantity        Int    /// Number of units reserved
  
  /// Linked order
  orderId         String?
  orderItemId     String? /// If linked to specific order item
  orderItems      OrderItem[] /// Backlink from order items
  
  /// Status
  status          String @default("RESERVED") /// RESERVED, CONFIRMED (paid), RELEASED, EXPIRED
  
  /// Expiry (auto-release after payment timeout)
  expiresAt       DateTime /// When this reservation expires if payment not confirmed
  
  /// Release metadata
  releasedAt      DateTime?
  releaseReason   String? /// PAYMENT_SUCCESS, PAYMENT_FAILED, EXPIRED, MANUAL
  
  /// Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
}

/// Shipping Address — snapshot of address for order fulfillment (PHASE 6)
model ShippingAddress {
  id              String @id @default(cuid())
  
  /// Address details
  fullName        String
  streetLine1     String
  streetLine2     String?
  city            String
  stateProvince   String
  postalCode      String
  country         String /// ISO 3166-1 alpha-2
  phoneNumber     String?
  
  /// Link to order
  orderId         String @unique /// One address per order
  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  /// Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([orderId])
}

model UserShippingAddress {
  id              String   @id @default(cuid())
  
  /// User who owns this address
  userId          Int
  user            User     @relation(name: "UserShippingAddresses", fields: [userId], references: [id], onDelete: Cascade)
  
  /// Address Details
  label           String?  /// "Home", "Work", "Mom's Place", etc.
  fullName        String
  streetLine1     String
  streetLine2     String?
  city            String
  stateProvince   String
  postalCode      String
  country         String   /// ISO 3166-1 alpha-2
  phoneNumber     String?
  
  /// Metadata
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  
  /// Audit Trail
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  
  @@index([userId])
  @@index([isActive])
  @@index([deletedAt])
  @@unique([userId, isDefault])  /// Only one default per user
}

model UserPaymentMethod {
  id              String   @id @default(cuid())
  
  /// User who owns this payment method
  userId          Int
  user            User     @relation(name: "UserPaymentMethods", fields: [userId], references: [id], onDelete: Cascade)
  
  /// Payment Provider & Token
  provider        String   /// "stripe", "midtrans", "paypal", etc.
  providerTokenId String   /// External token (e.g., "pm_1234...", never expose to user)
  
  /// Metadata (for display, not for payment)
  type            String   /// "card", "bank_transfer", "e_wallet", etc.
  brand           String?  /// "visa", "mastercard", "gopay", etc.
  last4Digits     String?  /// "4242" for masked display
  expiryMonth     Int?
  expiryYear      Int?
  cardholderName  String?
  
  /// Billing Address (optional, provider-specific)
  billingStreetLine1 String?
  billingStreetLine2 String?
  billingCity        String?
  billingStateProvince String?
  billingPostalCode   String?
  billingCountry      String?
  
  /// User-facing label
  label           String?  /// "My Visa", "Backup Card", etc.
  
  /// Metadata
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)  /// Can disable without deletion
  
  /// Audit Trail
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@unique([userId, isDefault])  /// Only one default per user
}

// =============================================================================
// AFFILIATE SYSTEM — Product-Level Affiliate Program (PHASE 8)
// =============================================================================

/// Affiliate — Registered affiliate accounts
/// Tracks affiliates who can earn commissions by referring sales
model Affiliate {
  id                    String   @id @default(cuid())
  
  /// Link to user account
  userId                Int      @unique
  user                  User     @relation(fields: [userId], references: [id])
  
  /// Status
  status                String   @default("active") /// active, suspended, pending_review
  
  /// Default commission rate (can be overridden per product)
  defaultCommissionRate Decimal  @db.Decimal(5, 4) /// e.g., 0.1000 = 10%
  
  /// Payment info (for payouts)
  payoutEmail           String?
  payoutMethod          String?  /// paypal, bank_transfer, etc.
  payoutDetails         Json?    /// Provider-specific payout details (encrypted in production)
  
  /// Metadata
  notes                 String?  /// Admin notes
  
  /// Audit
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  /// Relations
  productLinks          AffiliateProductLink[]
  commissions           AffiliateCommission[]
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// AffiliateProductLink — Unique referral links per affiliate per product
/// Each affiliate gets a unique referral code for each product they promote
model AffiliateProductLink {
  id              String   @id @default(cuid())
  
  /// Link ownership
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  
  /// Product being promoted
  productId       Int
  
  /// Unique referral code (used in URLs: ?ref={referral_code})
  referralCode    String   @unique
  
  /// Commission rate override (null = use affiliate's default rate)
  commissionRate  Decimal? @db.Decimal(5, 4)
  
  /// Status
  isActive        Boolean  @default(true)
  
  /// Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  /// Relations
  clicks          AffiliateClick[]
  
  @@unique([affiliateId, productId]) /// One link per affiliate per product
  @@index([affiliateId])
  @@index([productId])
  @@index([referralCode])
  @@index([isActive])
}

/// AffiliateClick — Tracks referral link clicks for analytics
/// Used for click attribution and anti-fraud analysis
model AffiliateClick {
  id                      String   @id @default(cuid())
  
  /// Link that was clicked
  affiliateProductLinkId  String
  affiliateProductLink    AffiliateProductLink @relation(fields: [affiliateProductLinkId], references: [id], onDelete: Cascade)
  
  /// Session tracking (for deduplication)
  sessionId               String   /// Browser session ID
  
  /// Fingerprinting (for fraud detection)
  ipAddress               String?
  userAgent               String?
  referer                 String?  /// HTTP Referer header
  
  /// Timestamp
  createdAt               DateTime @default(now())
  
  /// Dedupe: one click per session per link
  @@unique([affiliateProductLinkId, sessionId])
  @@index([affiliateProductLinkId])
  @@index([sessionId])
  @@index([ipAddress])
  @@index([createdAt])
}

/// AffiliateCommission — Financial record of commissions (IMMUTABLE)
/// Tracks commissions earned on orders, with full audit trail
/// Designed as append-only: status changes create new context, never update amounts
model AffiliateCommission {
  id              String   @id @default(cuid())
  
  /// Affiliate who earned the commission
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])
  
  /// Order context (immutable snapshot)
  orderId         String   /// Order that generated this commission
  orderItemId     String   /// Specific order item
  productId       Int      /// Product ID (denormalized for queries)
  
  /// Commission calculation (immutable after creation)
  baseAmountCents Int      /// Order item subtotal at time of purchase
  commissionRate  Decimal  @db.Decimal(5, 4) /// Rate locked at purchase time
  amountCents     Int      /// Calculated commission in cents
  currency        String   @default("USD") /// ISO 4217
  
  /// Status (append-only state machine)
  status          String   @default("pending") /// pending, approved, cancelled, paid
  
  /// Status transition timestamps
  approvedAt      DateTime?
  cancelledAt     DateTime?
  paidAt          DateTime?
  
  /// Cancellation/adjustment context
  cancellationReason String? /// refund, fraud, dispute, etc.
  refundId        String?    /// Link to refund if cancelled due to refund
  
  /// Payout tracking
  payoutBatchId   String?    /// Group commissions into payout batches
  
  /// Idempotency (prevent duplicate commissions)
  idempotencyKey  String     @unique /// {orderId}:{orderItemId}:{affiliateId}
  
  /// Audit
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  @@index([affiliateId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([status])
  @@index([payoutBatchId])
  @@index([createdAt])
}

/// AffiliatePayoutBatch — Groups approved commissions for payment processing
model AffiliatePayoutBatch {
  id              String   @id @default(cuid())
  
  /// Batch details
  affiliateId     String   /// Affiliate receiving payout
  
  /// Financial totals
  totalAmountCents Int     /// Sum of all commissions in batch
  currency        String   @default("USD")
  commissionCount Int      /// Number of commissions in batch
  
  /// Status
  status          String   @default("pending") /// pending, processing, paid, failed
  
  /// Payment details
  paymentMethod   String?  /// paypal, bank_transfer, etc.
  paymentReference String? /// External payment reference (PayPal txn ID, etc.)
  
  /// Timestamps
  processedAt     DateTime?
  paidAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  
  /// Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  /// Admin who initiated
  initiatedBy     Int?     /// Admin user ID
  
  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

/// AffiliateApplication — User applications to become affiliates
model AffiliateApplication {
  id                String   @id @default(cuid())
  
  /// User applying
  userId            Int      @unique
  user              User     @relation("AffiliateApplications", fields: [userId], references: [id], onDelete: Cascade)
  
  /// Application status
  status            String   @default("pending") /// pending, approved, rejected
  
  /// Application info
  email             String
  payoutMethod      String?  /// paypal, bank_transfer, etc.
  payoutDetails     Json?    /// Provider-specific payout details
  notes             String?  /// User notes/motivation
  
  /// Admin review
  adminNotes        String?  /// Reason for rejection or approval notes
  reviewedBy        Int?     /// Admin user ID
  reviewedAt        DateTime?
  
  /// Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}