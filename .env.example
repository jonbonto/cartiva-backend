# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_db"

# Node Environment
NODE_ENV="development"

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"
COMPANY_NAME="E-Commerce Store"

# SendGrid Email Configuration (PHASE 6)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SUPPORT_EMAIL="support@yourdomain.com"

# Stripe Payment Provider (PHASE 5.1)
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"

# Midtrans Payment Provider (PHASE 5)
MIDTRANS_SERVER_KEY="xxxxx"
MIDTRANS_CLIENT_KEY="xxxxx"
MIDTRANS_IS_PRODUCTION="false"

# JWT Configuration
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="1d"

# Admin Configuration
ADMIN_EMAIL="admin@example.com"

# Webhook Replay (PHASE 6)
# Maximum number of retry attempts for failed webhooks
WEBHOOK_RETRY_LIMIT="5"
# Delay between retries in milliseconds
WEBHOOK_RETRY_DELAY="1000"

# Rate Limiting (for email/webhook services)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Redis Configuration (PHASE 7 - Job Queues)
# Redis connection for Bull queue system
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Queue Configuration (PHASE 7)
# Number of concurrent jobs per queue
QUEUE_CONCURRENCY="10"
# Job retention (keep last N completed jobs)
QUEUE_COMPLETED_RETENTION="100"
# Failed job retention (keep last N failed jobs for debugging)
QUEUE_FAILED_RETENTION="500"
